#!/bin/bash
set -u

CONFIG_FILE=$HOME/.config/accio-brew/config
DATA_DIR=$HOME/.local/share/accio-brew
CLONE=$DATA_DIR/repo
LOCK_FILE=$DATA_DIR/lock
LOG_FILE=$HOME/Library/Logs/accio-brew.log
BINARY_LINK=$HOME/.local/bin/accio-brew
ZSHRC=${ZDOTDIR:-$HOME}/.zshrc
WRAPPER_BLOCK_START='# >>> accio-brew >>>'
WRAPPER_BLOCK_END='# <<< accio-brew <<<'
LAUNCHD_LABEL=io.accio-brew
LAUNCHD_PLIST=$HOME/Library/LaunchAgents/$LAUNCHD_LABEL.plist
DUMPED_TYPES=(--tap --formula --cask)

fail() {
  printf 'accio-brew: %s\n' "$*" >&2
  exit 1
}

utc_now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

log() {
  printf '%s %s %s\n' "$(utc_now)" "$HOST_ID" "$*"
}

resolve_tool_root() {
  local script=$0 link
  while link=$(readlink "$script"); do
    case $link in
      /*) script=$link ;;
      *) script=$(dirname "$script")/$link ;;
    esac
  done
  cd "$(dirname "$script")/.." && pwd
}

apply_config_defaults() {
  BREWFILE_PATH=${BREWFILE_PATH:-./Brewfile}
  BREWFILE=${BREWFILE_PATH#./}
}

load_config() {
  [ -f "$CONFIG_FILE" ] || fail "no config found, run accio-brew init"
  source "$CONFIG_FILE"
  [ -n "${REPO_URL:-}" ] && [ -n "${HOST_ID:-}" ] || fail "incomplete config, run accio-brew init"
  apply_config_defaults
  HOST_BRANCH=hosts/$HOST_ID
}

git_as_tool() {
  git -c user.name=accio-brew -c user.email="accio-brew@$HOST_ID" -c commit.gpgsign=false "$@" 9>&-
}

git_in_clone() {
  git -C "$CLONE" "$@" 9>&-
}

configured_ssh_command() {
  printf '%s' "${GIT_SSH_COMMAND:-$(git config --get core.sshCommand || echo ssh)}"
}

use_unattended_git() {
  export GIT_TERMINAL_PROMPT=0
  GIT_SSH_COMMAND="$(configured_ssh_command) -o BatchMode=yes -o ConnectTimeout=10"
  export GIT_SSH_COMMAND
}

clone_matches_repo() {
  [ "$(git_in_clone config --get remote.origin.url 2>/dev/null)" = "$REPO_URL" ]
}

ensure_clone() {
  if [ ! -d "$CLONE/.git" ]; then
    mkdir -p "$DATA_DIR"
    git clone --quiet --no-checkout "$REPO_URL" "$CLONE" 2>/dev/null || return 1
  fi
  clone_matches_repo || fail "local clone belongs to another repo, run accio-brew init"
}

wait_for_other_syncs() {
  mkdir -p "$DATA_DIR"
  exec 9>"$LOCK_FILE"
  /usr/bin/lockf 9 || fail "cannot lock $LOCK_FILE"
}

remote_host_branch_is_known() {
  git_in_clone rev-parse -q --verify "refs/remotes/origin/$HOST_BRANCH" >/dev/null
}

checkout_host_branch() {
  [ "$(git_in_clone symbolic-ref --short -q HEAD)" = "$HOST_BRANCH" ] && return
  if remote_host_branch_is_known; then
    git_in_clone checkout -q -f -B "$HOST_BRANCH" "origin/$HOST_BRANCH"
  else
    git_in_clone switch -q --orphan "$HOST_BRANCH"
  fi
}

dump_brewfile() {
  local dump
  dump=$(mktemp)
  if HOMEBREW_NO_AUTO_UPDATE=1 brew bundle dump --force --no-describe --no-restart "${DUMPED_TYPES[@]}" --file="$dump" >/dev/null 9>&- && [ -s "$dump" ]; then
    mkdir -p "$(dirname "$CLONE/$BREWFILE")"
    mv "$dump" "$CLONE/$BREWFILE"
  else
    rm -f "$dump"
    return 1
  fi
}

commit_if_changed() {
  git_in_clone add -- "$BREWFILE"
  if git_in_clone diff --cached --quiet; then
    log no-change
    return
  fi
  git_as_tool -C "$CLONE" commit -q -m "sync($HOST_ID): $(utc_now)" && log committed
}

host_branch_is_pushed() {
  local local_head
  local_head=$(git_in_clone rev-parse -q --verify HEAD) || return 0
  [ "$local_head" = "$(git_in_clone rev-parse -q --verify "refs/remotes/origin/$HOST_BRANCH")" ]
}

push_host_branch() {
  local push_output
  host_branch_is_pushed && return
  if push_output=$(LC_ALL=C git_in_clone push -q -u origin "$HOST_BRANCH" 2>&1); then
    log pushed
    return
  fi
  case $push_output in
    *'! [rejected]'*)
      log diverged
      exit 1
      ;;
  esac
  log push-failed
}

command_sync() {
  local started_at=$SECONDS
  load_config
  use_unattended_git
  wait_for_other_syncs
  log start
  if ! ensure_clone; then
    log clone-failed
    exit 1
  fi
  checkout_host_branch
  if ! dump_brewfile; then
    log dump-failed
    exit 1
  fi
  commit_if_changed
  push_host_branch
  log "done $((SECONDS - started_at))s"
}

default_branch() {
  git_in_clone remote set-head origin -a >/dev/null 2>&1
  git_in_clone symbolic-ref --short -q refs/remotes/origin/HEAD
}

fetch_target_brewfile() {
  local target_branch
  ensure_clone || fail "cannot reach $REPO_URL"
  git_in_clone fetch -q origin || fail "cannot reach $REPO_URL"
  target_branch=$(default_branch) || fail "cannot determine the default branch of $REPO_URL"
  git_in_clone show "$target_branch:$BREWFILE" > "$1" 2>/dev/null || fail "target Brewfile not found on remote"
}

install_target() {
  local target=$1 cleanup=$2
  brew bundle install --file="$target" || return
  [ "$cleanup" = --cleanup ] || return 0
  brew bundle cleanup --force "${DUMPED_TYPES[@]}" --file="$target"
}

command_apply() {
  local cleanup=${1:-} target install_status
  case $cleanup in
    ''|--cleanup) ;;
    *) fail "unknown option: $cleanup" ;;
  esac
  load_config
  target=$(mktemp)
  fetch_target_brewfile "$target"
  install_target "$target" "$cleanup"
  install_status=$?
  rm -f "$target"
  command_sync
  return $install_status
}

remove_wrapper() {
  local remaining
  grep -qxF "$WRAPPER_BLOCK_START" "$ZSHRC" 2>/dev/null || return 0
  grep -qxF "$WRAPPER_BLOCK_END" "$ZSHRC" || fail "incomplete accio-brew block in $ZSHRC, remove it by hand"
  remaining=$(mktemp)
  sed "/^$WRAPPER_BLOCK_START\$/,/^$WRAPPER_BLOCK_END\$/d" "$ZSHRC" > "$remaining"
  cat "$remaining" > "$ZSHRC"
  rm -f "$remaining"
}

install_wrapper() {
  [ -s "$ZSHRC" ] && [ -n "$(tail -c 1 "$ZSHRC")" ] && echo >> "$ZSHRC"
  {
    printf '%s\n' "$WRAPPER_BLOCK_START"
    printf 'source %q\n' "$TOOL_ROOT/modules/wrapper.zsh"
    printf '%s\n' "$WRAPPER_BLOCK_END"
  } >> "$ZSHRC"
  echo "Wrapper installed. Open a new terminal to activate it."
}

remove_launchd() {
  [ -f "$LAUNCHD_PLIST" ] || return 0
  launchctl bootout "gui/$(id -u)/$LAUNCHD_LABEL" 2>/dev/null
  rm -f "$LAUNCHD_PLIST"
}

install_launchd() {
  local agent_path
  agent_path=$(dirname "$(command -v brew)"):/usr/bin:/bin:/usr/sbin:/sbin
  mkdir -p "$(dirname "$LAUNCHD_PLIST")" "$(dirname "$LOG_FILE")"
  sed -e "s|__ACCIO_BREW__|$TOOL_ROOT/bin/accio-brew|" \
    -e "s|__PATH__|$agent_path|" \
    -e "s|__LOG__|$LOG_FILE|" \
    "$TOOL_ROOT/modules/launchd.plist" > "$LAUNCHD_PLIST"
  launchctl bootstrap "gui/$(id -u)" "$LAUNCHD_PLIST" || fail "cannot load $LAUNCHD_PLIST"
  echo "launchd agent installed. It syncs hourly."
}

install_trigger() {
  remove_wrapper
  remove_launchd
  "install_$SYNC_MODE"
}

command_teardown() {
  remove_wrapper
  remove_launchd
  rm -f "$BINARY_LINK"
  echo "Triggers removed. Still on disk: $TOOL_ROOT, $CONFIG_FILE, $CLONE, $LOG_FILE"
  echo "Your hosts/<id> branch on the remote is untouched."
}

ask() {
  local question=$1
  while true; do
    printf '%s' "$question"
    if ! read -r answer && [ -z "$answer" ]; then
      echo
      [ $# -ge 2 ] || fail "missing answer for: $question"
      answer=
    fi
    [ -n "$answer" ] && return
    if [ $# -ge 2 ]; then
      answer=$2
      return
    fi
  done
}

probe() {
  (use_unattended_git && git ls-remote "$1" 2>/dev/null)
}

probe_candidates() {
  local candidate
  probed_candidates=$*
  for candidate; do
    printf 'Checking %s ... ' "$candidate"
    if remote_refs=$(probe "$candidate"); then
      echo ok
      REPO_URL=$candidate
      remote_was_probed=true
      return 0
    fi
    echo failed
  done
  return 1
}

ask_repo_url() {
  local host repo_path
  echo "Where is your Brewfile repo?"
  echo "  1) github.com"
  echo "  2) gitlab.com"
  echo "  3) paste clone URL"
  ask "Choice [1]: " 1
  case $answer in
    2) host=gitlab.com ;;
    3)
      ask "Clone URL: "
      probe_candidates "$answer"
      return
      ;;
    *) host=github.com ;;
  esac
  ask "Repository (owner/name): "
  repo_path=${answer#/}
  repo_path=${repo_path%/}
  repo_path=${repo_path%.git}
  probe_candidates "https://$host/$repo_path.git" "git@$host:$repo_path.git"
}

keeps_current_repo() {
  [ -n "${REPO_URL:-}" ] || return 1
  [ -n "$mode_flag" ] && return 0
  ask "Keep repo $REPO_URL? [Y/n]: " y
  case $answer in
    n|N) return 1 ;;
  esac
}

choose_repo_url() {
  if [ -n "$repo_url_flag" ]; then
    probe_candidates "$repo_url_flag" || fail "cannot reach $repo_url_flag"
    return
  fi
  keeps_current_repo && return
  until ask_repo_url; do
    echo "Cannot reach $probed_candidates. Create the repo in your host's web UI or check access."
  done
}

as_host_id() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-'
}

confirm_host_id() {
  clone_matches_repo && return
  printf '%s\n' "$remote_refs" | grep -q "refs/heads/hosts/$HOST_ID\$" || return 0
  ask "hosts/$HOST_ID exists. Name for this Mac [$HOST_ID]: " "$HOST_ID"
  HOST_ID=$(as_host_id "$answer")
}

seed_empty_remote() {
  local seed
  [ -z "$remote_refs" ] || return 0
  seed=$(mktemp -d)
  git init -q -b main "$seed"
  mkdir -p "$(dirname "$seed/$BREWFILE")"
  : > "$seed/$BREWFILE"
  git -C "$seed" add -- "$BREWFILE"
  git_as_tool -C "$seed" commit -q -m "chore: add empty target Brewfile"
  git -C "$seed" push -q "$REPO_URL" HEAD:refs/heads/main || fail "cannot push the initial Brewfile to $REPO_URL"
  rm -rf "$seed"
  echo "The repo was empty. Created main with an empty target Brewfile."
}

validate_mode() {
  case $1 in
    wrapper|launchd) ;;
    *) fail "mode must be wrapper or launchd" ;;
  esac
}

choose_mode() {
  local default_choice=1
  if [ -n "$mode_flag" ]; then
    SYNC_MODE=$mode_flag
    return
  fi
  [ "${SYNC_MODE:-}" = launchd ] && default_choice=2
  echo "How should sync be triggered?"
  echo "  1) wrapper  - after every brew install/uninstall/upgrade"
  echo "  2) launchd  - hourly in the background"
  ask "Choice [$default_choice]: " "$default_choice"
  case $answer in
    2) SYNC_MODE=launchd ;;
    *) SYNC_MODE=wrapper ;;
  esac
}

write_config() {
  mkdir -p "$(dirname "$CONFIG_FILE")"
  {
    printf 'REPO_URL=%q\n' "$REPO_URL"
    printf 'BREWFILE_PATH=%q\n' "$BREWFILE_PATH"
    printf 'SYNC_MODE=%q\n' "$SYNC_MODE"
    printf 'HOST_ID=%q\n' "$HOST_ID"
  } > "$CONFIG_FILE"
}

drop_foreign_clone() {
  [ -d "$CLONE" ] || return 0
  clone_matches_repo || rm -rf "$CLONE"
}

link_binary() {
  mkdir -p "$(dirname "$BINARY_LINK")"
  ln -sf "$TOOL_ROOT/bin/accio-brew" "$BINARY_LINK"
  case ":$PATH:" in
    *":$(dirname "$BINARY_LINK"):"*) ;;
    *) echo "Add accio-brew to your PATH: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac
}

parse_init_flags() {
  repo_url_flag=
  mode_flag=
  while [ $# -gt 0 ]; do
    [ -n "${2:-}" ] || fail "missing value for $1"
    case $1 in
      --repo-url) repo_url_flag=$2 ;;
      --mode)
        mode_flag=$2
        validate_mode "$mode_flag"
        ;;
      *) fail "unknown option: $1" ;;
    esac
    shift 2
  done
}

command_init() {
  parse_init_flags "$@"
  command -v brew >/dev/null || fail "Homebrew is not installed"
  remote_was_probed=false
  [ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  apply_config_defaults
  choose_repo_url
  HOST_ID=${HOST_ID:-$(as_host_id "$(scutil --get LocalHostName)")}
  if $remote_was_probed; then
    confirm_host_id
    seed_empty_remote
  fi
  choose_mode
  write_config
  drop_foreign_clone
  link_binary
  command_sync
  install_trigger
  echo "Done. Run 'accio-brew apply' to install the target Brewfile on this Mac."
}

usage() {
  echo "usage: accio-brew init [--repo-url <url>] [--mode wrapper|launchd] | sync | apply [--cleanup] | teardown" >&2
  exit 1
}

TOOL_ROOT=$(resolve_tool_root)

case ${1:-} in
  init)
    shift
    command_init "$@"
    ;;
  sync) command_sync ;;
  apply) command_apply "${2:-}" ;;
  teardown) command_teardown ;;
  *) usage ;;
esac
